# OurDAO backend configuration
# Copy to .env and fill in.

# --- HTTP API ---
PORT=4000
HOST=0.0.0.0
# Comma-separated list of allowed CORS origins (the frontend URL). "*" allows all.
CORS_ORIGIN=http://localhost:3000

# --- Postgres ---
# Either a single connection string...
DATABASE_URL=postgres://ourdao:ourdao@localhost:5432/ourdao
# ...or leave DATABASE_URL empty and set these individually:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=ourdao
# PGPASSWORD=ourdao
# PGDATABASE=ourdao

# --- Stellar / Soroban ---
# Deployed OurDAO contract id (starts with C). REQUIRED for the indexer to run.
CONTRACT_ID=
# Soroban RPC endpoint (public testnet default).
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Network passphrase. Mainnet: "Public Global Stellar Network ; September 2015"
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# --- Indexer ---
# Ledger to begin indexing from. 0 = start from (latest - START_LOOKBACK_LEDGERS).
# Note: public Soroban RPC only retains ~24h of events, so a very old start
# ledger will be clamped to the oldest ledger the RPC still serves.
START_LEDGER=0
START_LOOKBACK_LEDGERS=17280
# How often to poll getEvents, in milliseconds.
POLL_INTERVAL_MS=5000
# Max events fetched per getEvents page.
EVENTS_PAGE_LIMIT=100
